# ── Supabase ─────────────────────────────────────────────────
# Project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key — both work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ── Site ─────────────────────────────────────────────────────
# Canonical URL, used for SEO metadata and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email (Resend) -----------------------------------------
# Optional: notifications + weekly digests. Without it, email is off.
RESEND_API_KEY=
EMAIL_FROM=LinkYaar <onboarding@resend.dev>
# Server-only: supabase service role (dashboard -> Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=
# Protects the cron endpoints on Vercel
CRON_SECRET=

# ---- Rate limiting (Upstash Redis, optional) ----------------
# Without these, limits fail open (features work, no throttling).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ---- AI (Google AI Studio, optional) -------------------------
GEMINI_API_KEY=

# ---- Analytics & errors (optional) ---------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
